# Valgrind suppressions for ShaderCandy CI
# System library leaks from Mesa GLX, ALSA, and PipeWire
# These are harmless internal allocations in stripped shared libraries

{
   mesa_glx_leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:calloc
   ...
   fun:_Z*
   ...
}

{
   alsa_pcm_leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:malloc
   ...
   fun:snd_*
   ...
}

{
   pipewire_leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:malloc
   ...
   fun:pw_*
   ...
}
