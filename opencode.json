{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "clangd": {
      "command": ["clangd", "--background-index", "--clang-tidy", "--completion-style=detailed", "--header-insertion=iwyu"],
      "extensions": ["c", "cpp", "cc", "cxx", "h", "hpp", "hxx", "mm", "metal"],
      "languages": {
        "c": "c",
        "cpp": "cpp",
        "cc": "cpp",
        "cxx": "cpp",
        "h": "c",
        "hpp": "cpp",
        "hxx": "cpp",
        "mm": "objective-cpp",
        "metal": "cpp"
      }
    }
  }
}
