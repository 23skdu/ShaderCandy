#!/usr/bin/make -f

export DH_VERBOSE = 1

DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
DEB_BUILD_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_BUILD_GNU_TYPE)

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_METAL=OFF \
		-DBUILD_OPENGL=ON \
		-DBUILD_SCREENSAVER_LINUX=ON \
		-DBUILD_SCREENSAVER_MACOS=OFF \
		-DBUILD_TESTS=OFF

override_dh_auto_install:
	dh_auto_install
	# Install shaders
	mkdir -p debian/shadercandy/usr/share/shadercandy/shaders
	cp -r ../shaders/*.frag debian/shadercandy/usr/share/shadercandy/shaders/ 2>/dev/null || true
	cp -r ../shaders/effects/*.frag debian/shadercandy/usr/share/shadercandy/shaders/ 2>/dev/null || true
	# Install xscreensaver config
	mkdir -p debian/shadercandy/etc/xscreensaver
	cp debian/xscreensaver-shadercandy debian/shadercandy/etc/xscreensaver/

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info
